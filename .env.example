# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# App
DATABASE_PATH=data/orchestrator.db
KNOWLEDGE_DB_PATH=data/knowledge.db
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Auth (REQUIRED for public deploy — leave empty only for local open access)
APP_PASSWORD=change-me
API_KEY=optional-api-key-for-scripts
SESSION_SECRET=replace-with-long-random-string
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Rate limits (SlowAPI syntax)
RATE_LIMIT_RUNS=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_MUTATE=30/minute
